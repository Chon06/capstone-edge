{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EdgeFrameMessage",
  "description": "Tin nhắn tầng Edge gửi vào topic edge-frames. Đổi cấu trúc thì phải tăng schema_version.",
  "type": "object",
  "required": [
    "schema_version", "run_id", "camera_id", "frame_seq", "timestamp",
    "edge_status", "defect_label", "confidence",
    "inference_ms", "upload_ms", "edge_latency_ms", "image_ref"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z$",
      "description": "Mã lần chạy (UTC lúc khởi động producer). frame_seq bắt đầu lại từ 1 ở mỗi run_id."
    },
    "camera_id": { "type": "string", "pattern": "^cam_[0-9]{2}$" },
    "frame_seq": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time", "description": "UTC, lúc dựng tin nhắn." },
    "edge_status": { "enum": ["OK", "NG"] },
    "defect_label": {
      "enum": ["crazing", "inclusion", "patches", "pitted_surface", "rolled-in_scale", "scratches", null]
    },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "inference_ms": { "type": "number", "minimum": 0, "description": "Đọc ảnh + trích đặc trưng + dự đoán." },
    "upload_ms": { "type": "number", "minimum": 0, "description": "Upload ảnh lên MinIO." },
    "edge_latency_ms": { "type": "number", "minimum": 0, "description": "Tổng: inference_ms + upload_ms." },
    "image_ref": { "type": "string", "pattern": "^minio://frames/" },
    "true_label": {
      "enum": ["crazing", "inclusion", "patches", "pitted_surface", "rolled-in_scale", "scratches"],
      "description": "Nhãn thật, chỉ để đánh giá offline. Trường tùy chọn."
    }
  },
  "additionalProperties": false
}
