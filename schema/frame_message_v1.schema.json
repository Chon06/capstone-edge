{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameMessage v1.0",
  "type": "object",
  "required": ["schema_version", "image_id", "camera_id", "frame_seq",
               "ts_capture_ms", "ts_edge_done_ms", "edge_latency_ms",
               "edge_status", "detections", "image_codec", "jpeg_quality", "image_b64"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "image_id": {"type": "string"},
    "camera_id": {"type": "string"},
    "frame_seq": {"type": "integer", "minimum": 0},
    "ts_capture_ms": {"type": "integer"},
    "ts_edge_done_ms": {"type": "integer"},
    "edge_latency_ms": {"type": "number", "minimum": 0},
    "edge_status": {"enum": ["OK", "NG"]},
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["defect_class", "confidence", "bbox_xyxy"],
        "properties": {
          "defect_class": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "bbox_xyxy": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}
        }
      }
    },
    "image_codec": {"enum": ["jpeg"]},
    "jpeg_quality": {"type": "integer", "minimum": 1, "maximum": 100},
    "image_b64": {"type": "string"}
  }
}
